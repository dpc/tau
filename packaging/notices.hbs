<!doctype html>
<html lang="en">
<meta charset="utf-8">
<title>Third-party notices</title>
<h1>Third-party notices</h1>
<p>Generated from the selected locked Cargo source graph for this architecture.
Includes build dependencies; excludes dependencies used only by tests.</p>
{{#each licenses}}
<section>
<h2>{{name}}</h2>
<ul>
{{#each used_by}}
<li>{{crate.name}} {{crate.version}} — {{crate.repository}}</li>
{{/each}}
</ul>
<pre>{{text}}</pre>
</section>
{{/each}}
</html>
