{
  "kind": "chat_completions",
  "base_url": "http://127.0.0.1:8080/v1",
  "api_key": "legacy-key",
  "models": [
    {
      "id": "local-model",
      "display_name": "Legacy Local",
      "context_window": 32768,
      "compat": {
        "stream_options": true,
        "parallel_tool_calls": true,
        "openai_prompt_cache": {
          "key": "agent",
          "options": {
            "mode": "implicit",
            "ttl": "30m"
          }
        },
        "reasoning_effort": {
          "mapping": [
            {
              "from": "0.0",
              "level": "none"
            },
            {
              "from": "0.1",
              "level": "minimal"
            },
            {
              "from": "0.2",
              "level": "low"
            },
            {
              "from": "0.35",
              "level": "medium"
            },
            {
              "from": "0.65",
              "level": "high"
            }
          ],
          "wire": "open_ai"
        }
      },
      "tags": [
        "shell:local"
      ]
    }
  ],
  "tags": [
    "provider:local"
  ],
  "max_output_tokens": 4096,
  "extra_body": {
    "chat_template_kwargs": {
      "enable_thinking": true
    }
  },
  "compat": {
    "stream_options": true,
    "openai_prompt_cache": {
      "key": "agent",
      "options": {
        "mode": "implicit",
        "ttl": "30m"
      }
    }
  }
}
