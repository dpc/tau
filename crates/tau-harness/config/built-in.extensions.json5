// Extensions configured by Tau. argv = prefix ++ command ++ suffix.
// When `command` is omitted, `builtin_extensions()` fills it with the
// running tau binary, so bundled components only need to specify their
// component subcommand in `suffix`. Explicit commands are separate
// executables that operators must install.
[
    {
        name: "provider-builtin",
        suffix: ["component", "ext-provider-builtin"],
        role: "provider",
        enable: true,
        config: {},
    },
    {
        name: "core-shell",
        suffix: ["component", "ext-shell"],
        role: "tool",
        enable: true,
        config: {},
    },
    {
        name: "test-dummy",
        suffix: ["component", "ext-test-dummy"],
        role: "tool",
        enable: false,
        config: {},
    },
    {
        name: "std-rhai",
        suffix: ["component", "ext-rhai"],
        role: "tool",
        enable: false,
        config: {},
    },
    {
        name: "std-rostra",
        command: ["tau-ext-rostra"],
        role: "tool",
        enable: false,
        startup_timeout_seconds: 10,
        config: {},
    },
    {
        name: "std-notifications",
        suffix: ["component", "ext-std-notifications"],
        role: "tool",
        enable: true,
        config: { "agent_start": [], "agent_end": [], "agent_idle": [], "agent_idle_all": [] },
    },
    {
        name: "std-slack",
        command: ["tau-ext-slack"],
        role: "tool",
        enable: false,
        config: { prefix_agent_id: false },
    },
    {
        name: "std-swarm",
        suffix: ["component", "ext-swarm"],
        role: "tool",
        enable: false,
        require: false,
        config: {},
    },
    {
        name: "std-telegram",
        command: ["tau-ext-telegram"],
        role: "tool",
        enable: false,
        config: {},
    },
    {
        name: "std-zulip",
        command: ["tau-ext-zulip"],
        role: "tool",
        enable: false,
        config: {},
    },
    {
        name: "std-xmpp",
        suffix: ["component", "ext-xmpp"],
        role: "tool",
        enable: false,
        config: {},
    },
    {
        name: "std-utils",
        suffix: ["component", "ext-utils"],
        role: "tool",
        enable: true,
        config: {},
    },
    {
        name: "std-websearch",
        suffix: ["component", "ext-websearch"],
        role: "tool",
        enable: true,
        config: {},
    },
    {
        name: "std-pim",
        suffix: ["component", "ext-pim"],
        role: "tool",
        enable: false,
        config: {},
    },
    {
        name: "std-email",
        suffix: ["component", "ext-pim"],
        role: "tool",
        enable: false,
        config: {},
    },
]
