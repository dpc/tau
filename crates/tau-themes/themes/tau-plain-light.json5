// Built-in "tau-plain-light" theme.
//
// Tuned for light terminal backgrounds. Style names mirror the other built-ins
// so the CLI can switch themes without changing semantic rendering code.
{
  description: "Light built-in theme for terminals with light backgrounds.",
  styles: {
    // -- User input --
    "user.prompt":          { bold: true },
    "user.prompt.queued":   { fg: "grey" },

    // -- Agent responses --
    "agent.response":       { fg: "dark_blue" },
    "agent.pending":        { fg: "grey" },
    "agent.thinking":       { fg: "grey", italic: true },

    // -- Markdown-lite transcript formatting --
    "markdown.strong":      { bold: true },
    "markdown.emphasis":    { bold: true, italic: true },
    "markdown.strikethrough": { fg: "dark_grey", strikethrough: true },
    "markdown.heading":     { fg: "blue", bold: true },
    "markdown.list.marker": { fg: "blue", bold: true },
    "markdown.code":        { fg: "#005fff" },
    "markdown.escape":      { bg: "#f1e8f5" },

    // -- Tool execution --
    "tool.output":          { },
    "tool.name":            { fg: "dark_yellow" },
    "watching.name":        { fg: "#af5f00" },
    "tool.mode":            { fg: "dark_yellow" },
    "tool.args":            { },
    "tool.status.success":  { fg: "dark_green" },
    "tool.status.error":    { fg: "dark_red" },
    "tool.status.info":     { fg: "dark_blue" },
    "tool.status.time":     { fg: "dark_grey" },
    "shell.output":         { },
    "progress.indicator":   { fg: "dark_cyan", bold: true },

    // -- Action output --
    "action.output":        { },
    "action.label":         { fg: "grey" },
    "action.value":         { },
    "action.id":            { fg: "dark_yellow", bold: true },
    "action.error":         { fg: "dark_red" },

    // -- Extensions --
    "extension.lifecycle":  { fg: "grey" },
    "extension.status":     { },

    // -- Sessions --
    "session.status":       { },

    // -- System --
    "system.info":          { fg: "grey" },
    "system.info.important": { fg: "dark_red", bold: true },
    "system.disconnect":    { fg: "dark_red", bold: true },
    "system.path":          { fg: "dark_blue" },
    "system.status":        { },

    // -- Status bar --
    "model.status":         { fg: "grey" },
    "status.model":         { fg: "grey" },
    "status.role":          { fg: "dark_yellow" },
    "status.session":       { fg: "dark_cyan" },
    "status.context":       { fg: "dark_blue" },
    "status.quota.under":   { fg: "green", bold: true },
    "status.quota.aligned": { fg: "dark_green" },
    "status.quota.over":    { fg: "dark_yellow" },
    "status.quota.danger":  { fg: "dark_red" },
    "status.quota.unknown": { fg: "grey" },
    "status.effort":        { fg: "dark_yellow" },
    "status.verbosity":     { fg: "dark_magenta" },
    "status.service_tier":  { fg: "dark_green" },
    "status.tools":         { fg: "dark_yellow" },
    "status.agents":        { fg: "blue" },
    "status.ui_io.low":     { fg: "grey" },
    "status.ui_io.medium":  { fg: "yellow" },
    "status.ui_io.high":    { fg: "dark_red" },
    "redraw.counter":       { fg: "dark_red" },

    // -- Token stats --
    "token.stats":                  { fg: "grey" },
    "token.stats.symbol.delta":     { bold: true },
    "token.stats.symbol.sigma":     { bold: true },
    "token.stats.symbol.up":        { },
    "token.stats.symbol.down":      { },
    "token.stats.metric.cache_hit": { },
    "token.stats.metric.cache_warn": { fg: "dark_yellow" },
    "token.stats.metric.cache_miss": { fg: "dark_red" },
    "token.stats.metric.input":     { },
    "token.stats.metric.output":    { },
    "token.stats.metric.latency":   { },

    // -- Prompt --
    "prompt.marker":           { bold: true },
    "prompt.cwd":              { fg: "dark_blue" },
    "prompt.placeholder":      { fg: "grey", italic: true },
    "prompt.marker.engineer":  { fg: "dark_cyan", bold: true },
    "prompt.marker.assistant": { fg: "red", bold: true },
    "prompt.marker.manager":   { fg: "dark_yellow", bold: true },
    "prompt.marker.submitted": { bold: true },

    // -- Completion menu --
    "completion.label":     { fg: "dark_green" },
    "completion.desc":      { fg: "grey" },
    "completion.selected":  { fg: "black", bg: "cyan", bold: true },

    // -- Banner --
    "banner.accent":        { fg: "dark_yellow" },
    "banner.logo":          { fg: "black" },
    "banner.name":          { fg: "black", bold: true },
    "banner.version":       { fg: "grey" },
    "banner.build":         { fg: "grey" },
    "banner.pun":           { fg: "dark_yellow" },

    // -- Diffs --
    "diff.added":           { fg: "dark_green" },
    "diff.removed":         { fg: "dark_red" },
    "diff.context":         { fg: "grey" },
    "diff.hunk_header":     { fg: "dark_cyan" },
    "diff.added.inline":    { fg: "green", bold: true },
    "diff.removed.inline":  { fg: "red", bold: true },
  }
}
